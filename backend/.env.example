# 复制为 .env 后填入真实值；.env 不入库
DATABASE_URL=postgresql://zhixu:zhixu@localhost:5432/zhixu?schema=public
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zhixu
MINIO_PUBLIC_URL=http://localhost:9000/zhixu

SESSION_SECRET=change-me-in-production
SESSION_TTL=86400

ORDER_PENDING_TTL_MINUTES=15
JOB_SCAN_INTERVAL_SECONDS=60

# 逗号分隔，允许携带凭证的前端来源
CORS_ORIGINS=http://localhost:5173

BCRYPT_COST=12
# 仅 dev/staging 置 true，prod 必须为 false
SEED_DEMO_DATA=false